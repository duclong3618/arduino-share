generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  emailVerified DateTime?
  passwordHash String?
  avatarUrl    String?
  reputation   Int       @default(0)
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]
  comments     Comment[]
  upvotes      Upvote[]
  badges       UserBadge[]
  sessions     Session[]
  accounts     Account[]

  @@map("users")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

// ─── Accounts (NextAuth) ─────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Projects (Code Submissions) ─────────────────────────

model Project {
  id                  String   @id @default(cuid())
  userId              String
  title               String
  slug                String   @unique
  description         String   @db.Text
  code                String   @db.Text
  boardType           BoardType
  difficulty          Difficulty
  hardwareRequirements String  @db.Text
  usageGuide          String   @db.Text
  wiringDiagramUrl    String?
  status              ProjectStatus @default(PENDING)
  upvotes             Int      @default(0)
  viewCount           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags                ProjectTag[]
  errors              ProjectError[]
  comments            Comment[]
  versions            ProjectVersion[]
  upvotesList         Upvote[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([upvotes])
  @@map("projects")
}

enum BoardType {
  UNO
  MEGA
  NANO
  ESP32
  ESP8266
  LEONARDO
  DUE
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// ─── Errors ──────────────────────────────────────────────

model ProjectError {
  id           String   @id @default(cuid())
  projectId    String
  errorMessage String   @db.Text
  cause        String   @db.Text
  fix          String   @db.Text
  codeSnippet  String?  @db.Text
  upvotes      Int      @default(0)
  createdAt    DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  upvotesList Upvote[]

  @@index([projectId])
  @@index([upvotes])
  @@map("project_errors")
}

// ─── Tags ────────────────────────────────────────────────

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  category  TagCategory
  projects  ProjectTag[]

  @@map("tags")
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

enum TagCategory {
  SENSOR
  MOTOR
  IOT
  DISPLAY
  COMMUNICATION
  POWER
  INPUT
  LED
  AUDIO
  OTHER
}

// ─── Comments ────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("comments")
}

// ─── Project Versions ────────────────────────────────────

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  code      String   @db.Text
  changelog String?  @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_versions")
}

// ─── Upvotes ─────────────────────────────────────────────

model Upvote {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  errorId      String?
  createdAt    DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  error   ProjectError? @relation(fields: [errorId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, errorId])
  @@map("upvotes")
}

// ─── Badges ──────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String
  criteria    String      @db.Text
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Reports ─────────────────────────────────────────────

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  projectId    String?
  commentId    String?
  reason       String   @db.Text
  status       ReportStatus @default(PENDING)
  createdAt    DateTime @default(now())

  @@index([status])
  @@map("reports")
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}
