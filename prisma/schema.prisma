generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  avatarUrl     String?   @map("avatar_url")
  reputation    Int       @default(0)
  role          UserRole  @default(USER)
  isBanned      Boolean   @default(false) @map("is_banned")
  banReason     String?   @map("ban_reason")
  bannedAt      DateTime? @map("banned_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projects  Project[]
  comments  Comment[]
  upvotes   Upvote[]
  badges    UserBadge[]
  sessions  Session[]
  accounts  Account[]

  @@map("users")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

// ─── Accounts (NextAuth) ─────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text @map("refresh_token")
  access_token      String? @db.Text @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @db.Text @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Projects (Code Submissions) ─────────────────────────

model Project {
  id                  String        @id @default(cuid())
  userId              String        @map("user_id")
  title               String
  slug                String        @unique
  description         String        @db.Text
  code                String        @db.Text
  boardType           BoardType     @map("board_type")
  difficulty          Difficulty
  hardwareRequirements String       @db.Text @map("hardware_requirements")
  usageGuide          String        @db.Text @map("usage_guide")
  wiringDiagramUrl    String?       @map("wiring_diagram_url")
  status              ProjectStatus @default(PENDING)
  upvotes             Int           @default(0)
  viewCount           Int           @default(0) @map("view_count")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        ProjectTag[]
  errors      ProjectError[]
  comments    Comment[]
  versions    ProjectVersion[]
  upvotesList Upvote[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([upvotes])
  @@map("projects")
}

enum BoardType {
  UNO
  MEGA
  NANO
  ESP32
  ESP8266
  LEONARDO
  DUE
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// ─── Errors ──────────────────────────────────────────────

model ProjectError {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  errorMessage String   @db.Text @map("error_message")
  cause        String   @db.Text
  fix          String   @db.Text
  codeSnippet  String?  @db.Text @map("code_snippet")
  upvotes      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  upvotesList Upvote[]

  @@index([projectId])
  @@index([upvotes])
  @@map("project_errors")
}

// ─── Tags ────────────────────────────────────────────────

model Tag {
  id       String      @id @default(cuid())
  name     String      @unique
  category TagCategory
  projects ProjectTag[]

  @@map("tags")
}

model ProjectTag {
  projectId String  @map("project_id")
  tagId     String  @map("tag_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

enum TagCategory {
  SENSOR
  MOTOR
  IOT
  DISPLAY
  COMMUNICATION
  POWER
  INPUT
  LED
  AUDIO
  OTHER
}

// ─── Comments ────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("comments")
}

// ─── Project Versions ────────────────────────────────────

model ProjectVersion {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  code      String    @db.Text
  changelog String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_versions")
}

// ─── Upvotes ─────────────────────────────────────────────

model Upvote {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  projectId String?   @map("project_id")
  errorId   String?   @map("error_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  error   ProjectError? @relation(fields: [errorId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, errorId])
  @@map("upvotes")
}

// ─── Badges ──────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String
  criteria    String      @db.Text
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Reports ─────────────────────────────────────────────

model Report {
  id         String       @id @default(cuid())
  reporterId String       @map("reporter_id")
  projectId  String?      @map("project_id")
  commentId  String?      @map("comment_id")
  reason     String       @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([status])
  @@map("reports")
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}
